# Copy this file to the Redmine application's config directory:
#   config/slackmine.yml
# Do not commit this file because it contains Slack credentials.

slack:
  # Slack permalink cards in issue descriptions/comments. Six-digit hex color.
  # Override with projects.<identifier>.slack.link_cards.color.
  link_cards:
    # false disables Slack link fetching, new quote imports, and all card displays.
    # Existing saved quotes remain readable as plain text. Defaults to true.
    enabled: true
    # Redmine web cards/live previews only; quote imports and mail remain enabled.
    # Defaults to true. All link_cards switches support project overrides.
    redmine_enabled: true
    link_text: 'Open in Slack'
    # HTML email quote cards and inline Slack logo. Omitted defaults to true.
    # false keeps quotes as plain text; Redmine cards are unaffected.
    mail_enabled: true
    color: '#6D5DFB'
  # Register this command in Slack with Request URL /slackmine/commands.
  # Requires the commands scope and an app reinstall. Omit to disable.
  # Use /slackmine reminders for a private, on-demand digest of your due issues.
  slash_command: /slackmine
  # SLACK_BOT_TOKEN can supply the shared token instead.
  bot_token: 'xoxb-REPLACE-ME'
  default_channel_id: 'C0123456789'
  # Requires users:read and an app reinstall. Ambiguous names are not mentioned.
  auto_map_users_by_name: false
  # User email matching and channel name matching below do not control mentions.
  # Authorize Work Object details/thread replies using a unique active Redmine
  # user with a matching registered email. Explicit users mappings take priority.
  # Requires users:read + users:read.email and an app reinstall.
  auto_map_users_by_email: false
  # Match project display names to bot-member channel names (case-insensitive;
  # spaces become hyphens). Explicit project channel IDs take priority.
  # No unique match/API failure falls back to default_channel_id.
  # Requires channels:read (public) / groups:read (private) and app reinstall.
  # Channel listings are cached in process memory for 10 minutes.
  auto_map_channels_by_name: false
  # Add a Task Work Object preview to public Issue creation/update/comment
  # notifications. Enable Work Object Previews > Task in the Slack app too.
  # Existing event cards remain. Deleted Issues and due-date DMs are excluded.
  # Override per project with projects.<identifier>.slack.work_object_previews.
  work_object_previews: false
  # Show editable Issue fields and actions on all public Issue Work Object
  # cards when true. Omitted or false disables actions.
  # Redmine user mapping and permissions are checked again on submission.
  # Set Interactivity & Shortcuts Request URL to /slackmine/interactions.
  work_object_actions: true
  # Enabled buttons follow YAML order: first 2 primary, next 5 in More.
  # At most 7 can be displayed. Unlisted buttons are hidden when this map is set.
  work_object_buttons:
    add_comment: false
    reply: false
    open_issue: false
    edit_issue: false
    change_assignee: false
    assign_to_me: false
    # With both enabled, show Start work until started, then Complete work.
    # Hide both after completion or when closed. Configure both status IDs below.
    start_work: true
    complete_work: true
    log_time: false
    watch: false
  # Required for start_work: the workflow status ID, not its display name.
  work_object_start_status_id: 3
  # Completion status ID; use the actual completed status from your workflow.
  work_object_complete_status_id: 5
  # Card body fields, independent of action buttons and notification metadata.
  # Unspecified fields are hidden. Per-project overrides apply.
  # Display order follows these keys. Project keys come first, then inherited keys.
  work_object_fields:
    assignee: true
    priority: false
    due_date: true
    category: false
    done_ratio: false
    project: false
    tracker: false
    author: false
    updater: false
    target_version: false
    start_date: false
    estimated_hours: false
    # Latest public comment: author, ISO 8601 time, and up to 1000 characters.
    status: true
    description: false
    last_comment: false
  # Save text/file replies to Issue notification threads as Redmine notes.
  # Requires slack.events, explicit users mappings or auto_map_users_by_email,
  # message.groups + groups:history (private channels), and an app reinstall.
  # Files also require files:read. Images preview inline; other files use download links.
  # Up to 10 files,
  # 10 MiB each (or Redmine's lower attachment limit), 50 MiB total per reply.
  thread_comments: false
  # Bot posts and human replies addressed to Bot/app users are always excluded.
  # Mention recipient checks require users:read; excluded replies get no feedback.
  # Suppress outgoing Slack notifications for comments imported from Slack threads.
  # Defaults to true; false sends normal notifications (event switches still apply).
  # Independent of thread_comments and personal email suppression; project overrides supported.
  suppress_thread_comment_notifications: true
  # Combine replies from the same author in the same thread into one note.
  # This example waits for 60 seconds of silence, at most 300 seconds from the first reply.
  # A different human author flushes the preceding turn in the incoming reply job.
  # The new author starts the normal wait; Bot posts and Bot-directed mentions do not flush.
  # Omitted wait_seconds or 0 saves immediately. Omitted max_wait_seconds defaults to 300.
  # Requires a scheduled-job worker and conversations.replies access when batching is enabled.
  thread_comment_batch:
    wait_seconds: 60
    max_wait_seconds: 300
  # Keep conversations readable: show the import result, then clear Bot feedback.
  # Delete result messages after this many seconds (default: -1; e.g. 60).
  # -1 keeps them; 0 suppresses feedback entirely. Original replies and Redmine notes remain.
  # Requires a scheduled-job worker. Project overrides are supported.
  thread_comment_feedback_cleanup_seconds: -1
  # Publish personal open-issue lists in the shared Slack app's Home tab.
  # Enable App Home > Home Tab and subscribe to app_home_opened at the Events URL.
  # Requires shared slack.events, bot_token and user mappings (or email matching).
  # Project overrides may disable this; apps configured only per project are not used.
  app_home: false
  # Post comment-only additions/edits/deletions in the latest Issue notification
  # thread, showing only the comment body (edits/deletions retain body/diffs).
  # Falls back to a full channel notification if no match is found or lookup fails.
  # Requires slack.events.app_id and groups:history / channels:history.
  # Search is bounded to 3 pages of up to 100 channel messages each.
  comment_notifications_in_threads: false
  # Required for clickable Work Object details. Configure the Slack app's
  # Events Request URL as https://redmine.example.com/slackmine/events and subscribe
  # to entity_details_requested. Work Object unfurl refresh additionally requires
  # links:read, links:write, link_shared, and the issue host in App unfurl domains.
  # Reinstall the Slack app after changing scopes or unfurl domains.
  # The Signing Secret is NOT the Bot Token.
  # events:
  #   app_id: 'A0123456789'
  #   team_id: 'T0123456789'
  #   signing_secret: 'REPLACE-ME' # or SLACK_SIGNING_SECRET
  # true/false still applies to all edits. Use this map to choose per content type.
  # Deleted comments always show removed lines regardless of these settings.
  body_diff:
    issue:
      description: true
      comment: true
    wiki:
      body: true
    news:
      description: true
      comment: true
    document:
      description: true
    message:
      body: true
  # Six-digit hexadecimal color for the left border of the Slack attachment.
  attachment_color: '#6D5DFB'
  # Issue fields are shown on creation and every update, even when unchanged.
  # Other notification types show their listed metadata fields by default.
  metadata:
    issue:
      project: true
      updater: true
      tracker: true
      category: true
      priority: true
      status: false
      assignee: false
      author: false
      target_version: false
      start_date: false
      due_date: false
      estimated_hours: false
      done_ratio: false
      parent_issue: false
      children: false
      relations: false
      attachments: false
      watchers: false
      custom_fields:
            '42': false
    wiki:
      project: true
      updater: true
      location: true
    document:
      project: true
      updater: true
    file:
      project: true
      updater: true
    message:
      project: true
      updater: true
    news:
      project: true
      updater: true
    news_comment:
      project: true
      updater: true
    time_entry:
      project: true
      updater: true
      hours: true
      spent_on: true
    version:
      project: true
      updater: true
      status: true
      due_date: true
    project:
      project: true
      updater: true
  # Also show changes to Issue fields hidden from metadata above.
  # Changes to visible fields and the description diff are always shown.
  issue_changes_when_hidden: true

# Run slackmine:due_reminders once daily to DM assigned users until the
# Issue reaches a closed Redmine status. The first DM is 3 days before the due
# date unless the rake task's days option overrides this setting.
due_reminders:
  enabled: true
  days: 3
  colors:
    overdue: '#D92D20'
    today: '#F79009'
    # Uncomment to override the upcoming color. When omitted, it uses
    # slack.attachment_color (default: '#6D5DFB').
    # upcoming: '#6D5DFB'

# All displayed notification wording is optional. The values below are examples;
# edit individual keys as needed. %{...} are placeholders.
messages:
  app_home:
    title: My issues
    all: All sections
    my: Assigned to me
    reported: Reported by me
    updated: Updated by me
    this_week: Due this week
    refresh: Refresh
    detail: Open details
    open: Open in Redmine
    empty: No open issues.
    unmapped: Your Slack account is not linked to an active Redmine user.
    limit: Up to 10 open issues per section. Open details or refresh to get current data.
  commands:
    project: 'Project'
    continue: 'Continue'
    message_project: 'Choose a project (up to 100). The next form includes the selected message and its source link.'
    source_message: 'Source Slack message'
    message_expired: 'This form expired. Open the message shortcut again.'
    message_retry: 'Could not retrieve the source link. Please retry.'
    processing: 'This submission is still processing. Check the issue before retrying.'
    full_form: 'Open the full form in Redmine'
    # %{command} is replaced with slack.slash_command.
    help: |-
      *%{command} — Issue commands*
      • `%{command} my` — Your assigned open issues (up to 10).
      • `%{command} due` — Your overdue issues and issues due within 3 days (up to 10).
      • `%{command} reminders` — Your personal due-reminder digest, using the configured reminder window. No day argument.
      • `%{command} search words` — Search issue subjects (up to 10).
      • `%{command} 123` — Show one issue; automatically use a card when Work Object previews are configured.
      • `%{command} new [project-identifier]` — Choose a project and open the issue creation form.
      • `%{command} comment 123` — Open the comment form from the returned button. Enter the comment in the form.
      • `%{command} status 123 [status name or ID]` — Change status directly, or omit the value to open a picker.
      • `%{command} assign 123 [user login, name, or ID]` — Change assignee directly. Use me or none; omit the value to open a picker.
      • `%{command} help` — Show this help.

      Results are visible only to you. Lists use the reminder format; a single result uses a card when configured.
    denied: 'Not available. Check your account mapping, permissions, and configuration.'
    empty: 'No matching results.'
    results: 'Issues (up to 10 results)'
    choose_project: 'Choose a project (up to 20). Use new <project identifier> to narrow the list.'
    my: 'My issues'
    search: 'Search results'
    due: 'Due soon'
    reminders: 'My due reminders'
    reminders_empty: 'No due reminders for you with the current reminder settings.'
    new: 'New issue'
    comment: 'Add comment'
    status: 'Change status'
    assign: 'Change assignee'
    updated: 'Issue updated.'
    unchanged: 'The issue already has that value.'
    no_match: 'No unique permitted match. Use an ID or choose from the returned button.'
    save: 'Save'
    cancel: 'Cancel'
    tracker: 'Tracker'
    subject: 'Subject'
    description: 'Description'
  events:
    document:
      created: Document created
      updated: Document updated
      deleted: Document deleted
    file:
      added: File added
      updated: File updated
      deleted: File deleted
    message:
      posted: Message posted
      updated: Message updated
      deleted: Message deleted
    issue:
      created: Issue created
      updated: Issue updated
      deleted: Issue deleted
    comment:
      added: Comment added
      updated: Comment updated
      deleted: Comment deleted
    wiki:
      created: Wiki page created
      updated: Wiki page updated
      deleted: Wiki page deleted
    news:
      created: News created
      updated: News updated
      deleted: News deleted
    news_comment:
      added: News comment added
      updated: News comment updated
      deleted: News comment deleted
    time_entry:
      created: Time entry created
      updated: Time entry updated
      deleted: Time entry deleted
    version:
      created: Version created
      updated: Version updated
      deleted: Version deleted
    project:
      updated: Project updated
  icons:
    document:
      created: '📄'
      updated: '✏️'
      deleted: '🗑️'
    file:
      added: '📎'
      updated: '✏️'
      deleted: '🗑️'
    message:
      posted: '💬'
      updated: '✏️'
      deleted: '🗑️'
    issue:
      created: '🆕'
      updated: '🔄'
      deleted: '🗑️'
    comment:
      added: '💬'
      updated: '💬'
      deleted: '🗑️'
    wiki:
      created: '📚'
      updated: '✏️'
      deleted: '🗑️'
    news:
      created: '📰'
      updated: '📰'
      deleted: '🗑️'
    news_comment:
      added: '💬'
      updated: '✏️'
      deleted: '🗑️'
    time_entry:
      created: '⏱️'
      updated: '⏱️'
      deleted: '🗑️'
    version:
      created: '🏷️'
      updated: '🏷️'
      deleted: '🗑️'
    project:
      updated: '🗂️'
  # Optional card colors: same type/action keys as icons. Omitted or invalid
  # values fall back to slack.attachment_color. Project overrides are supported.
  # colors:
  #   document:
  #     created: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   file:
  #     added: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   message:
  #     posted: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   issue:
  #     created: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   comment:
  #     added: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   wiki:
  #     created: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   news:
  #     created: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   news_comment:
  #     added: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   time_entry:
  #     created: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   version:
  #     created: '#6D5DFB'
  #     updated: '#6D5DFB'
  #     deleted: '#6D5DFB'
  #   project:
  #     updated: '#6D5DFB'
  sections:
    content: Content
    comment: Comment
    summary: Summary
    changes: Changes
    metadata: Metadata
    added_comment: Added comment
    updated_comment: Updated comment
    description: Description
    body: Body
  fields:
    project: Project
    updater: Updated by
    poster: Posted by
    tracker: Tracker
    category: Category
    priority: Priority
    status: Status
    assignee: Assignee
    target_version: Target version
    parent_issue: Parent issue
    child_issue: Child issue
    subject: Subject
    description: Description
    start_date: Start date
    due_date: Due date
    attachment: Attachment
    relation: Related issue (%{type})
    location: Changed location
    hours: Hours
    spent_on: Spent on
    author: Author
    estimated_hours: Estimated hours
    done_ratio: Done ratio
    last_comment: Last comment
    children: Child issues
    relations: Related issues
    attachments: Attachments
    watchers: Watchers
    custom_fields: Custom fields
  relations:
    relates: Related
    duplicates: Duplicates
    duplicated: Duplicated by
    blocks: Blocks
    blocked: Blocked by
    precedes: Precedes
    follows: Follows
    copied_to: Copied to
    copied_from: Copied from
  values:
    unknown_user: Unknown user
    unknown: Unknown
    unset: Not set
    unassigned: Unassigned
    none: None
    empty: "(empty)"
    added: Added
    removed: Removed
    created: created
    updated: updated
    deleted: deleted
  diff:
    heading: "%{label} diff"
    omitted: Diff truncated. See the linked page for the full text.
  images:
    alt: Image
    link_label: 'Image: %{name}'
  templates:
    # Visible heading for Issue updates, including updates with a comment.
    issue_updated_header: "%{actor} *%{event}*"
    issue_fallback: "[%{project}] %{actor} %{action} %{tracker} #%{id}: %{subject}"
    journal_fallback: "[%{project}] %{actor} %{event} %{tracker} #%{id}: %{subject}"
    generic_fallback: '%{event} - %{subject}'
  # Service name in Work Object cards and the details header/open button.
  # Projects may override any messages key under projects.<identifier>.messages.
  work_objects:
    product_name: 'Redmine'
    # Entity label used by Slack headers and menus; independent of the tracker.
    display_type: 'Issue'
    # Override these labels to localize cards, detail actions, and edit dialogs.
    # edit_title and edit_failed support %{id}. Keep modal titles short.
    edit_issue: 'Edit issue'
    change_assignee: 'Change assignee'
    # Supports %{product_name}; for example: 'Open in %{product_name}'
    open_issue: 'Open %{product_name}'
    assign_to_me: 'Assign to me'
    start_work: 'Start work'
    complete_work: 'Complete work'
    log_time: 'Log time'
    watch_settings: 'Watch settings'
    watching: 'You are watching this issue.'
    not_watching: 'You are not watching this issue.'
    watch: 'Watch'
    unwatch: 'Unwatch'
    add_comment: 'Add comment'
    reply: 'Reply'
    reply_hint: 'Return to the most recent former assignee and add a comment. If reassignment is unavailable, only the comment is added.'
    comment_placeholder: 'Enter a comment'
    edit_title: 'Edit issue #%{id}'
    save: 'Save'
    cancel: 'Cancel'
    edit_failed: 'Could not update issue #%{id}. Check your permissions and the current state.'
    operation_failed: 'Could not perform this action. Check your permissions and the current state.'
  # Headings for compact comment notifications inside Slack threads.
  # Supports %{product_name}, %{id}, %{actor}, and %{subject}.
  # References to the current Issue as #%{id} automatically become links.
  thread_notifications:
    added_header: '%{product_name} #%{id}: New comment'
    updated_header: '%{product_name} #%{id}: Comment updated'
    deleted_header: '%{product_name} #%{id}: Comment deleted'
  thread_comments:
    # Supports %{id} and %{product_name}; #%{id} automatically becomes a link.
    saved: '✅ Comment added to Redmine #%{id}.'
    restricted: '⚠️ Could not add the comment. Check the user mapping, Issue permissions and state, and text length.'
    image_failed: '⚠️ The reply was not saved. Check file size, file access, and the files:read bot scope.'
  due_reminders:
    # Omit a key to use its built-in default. Projects can override keys under
    # projects.<identifier>.messages.due_reminders.
    part_suffix: ' (%{part}/%{total_parts})'
    fallback: 'Due reminders%{suffix}: %{count} total (overdue: %{overdue_count}, due today: %{today_count})'
    title: '📋 *Due reminders: %{count}%{suffix}*'
    overdue_label: '🚨 Overdue'
    today_label: '⏰ Due today'
    upcoming_label: '📅 Due soon'
    group_fallback: '%{label}: %{count}'
    group_heading: '*%{label} (%{count})*'
    group_continued: '*%{label} (continued)*'
    overdue_timing: '%{days}d overdue'
    upcoming_timing: '%{days}d left'
    timing_suffix: ' · %{timing}'
    issue_line: '• <%{url}|#%{id} %{subject}> · %{project}%{timing}'

# issue.updated.enabled is the parent switch for all Issue detail events below.
# Setting it to false suppresses them even when an individual key is true.
# Newly supported deletion events below default to false; other omitted events default to true.
events:
  issue:
    created: true
    updated:
      enabled: true
      other_changed: true # Tracker and other Issue details
      relation:
        added: true
        removed: true
      status_changed: true
      assignee_changed: true
      priority_changed: true
      category_changed: true
      due_date_changed: true
      start_date_changed: true
      version_changed: true # Issue target version; distinct from events.version.updated
      subject_changed: true
      description_changed: true
      custom_field_changed: true
      attachment:
        added: true
        removed: true
      parent_changed: true
      child:
        added: true
        removed: true
    deleted: true
    comment:
      added: true # Independent of issue.updated.enabled
      updated: true
      deleted: true
  wiki:
    created: true
    updated: true
    deleted: false
  news:
    created: true
    updated: true
    deleted: false
    comment:
      added: true # Independent of news.updated
      updated: true # Detects Comment record updates; standard News UI has no edit action
      deleted: true
  time_entry:
    created: true
    updated: true
    deleted: false
  version:
    created: true
    updated: true
    deleted: false
  document:
    created: true
    updated: true
    deleted: false
    file:
      added: true
      updated: true
      deleted: false
  file:
    added: true
    updated: true
    deleted: false
  message:
    posted: true
    updated: true
    deleted: false

  project:
    updated: true

# Resolve each level child-to-root: explicit channel, then automatic name match.
# Use the global default only when no project in the hierarchy resolves a channel.
# Only channel routing follows the Redmine hierarchy; other settings do not.
projects:
  agentic:
    # The same slack, events, messages, and users trees can be overridden here.
    # Omitted keys inherit global values. A project bot_token overrides SLACK_BOT_TOKEN.
    slack:
      bot_token: 'xoxb-AGENTIC-BOT-TOKEN'
      default_channel_id: 'C0123456789'
      attachment_color: '#123456'
      # work_object_previews: true
    # The older project-level channel_id remains supported.
    # channel_id: 'C0123456789'
    # Every events key can override the matching global value.
    # If the global issue.updated.enabled is false, set it true here to enable details.
    # events:
    #   issue:
    #     updated:
    #       enabled: true
    #       status_changed: false
    #   wiki:
    #     deleted: true
    # messages:
    #   events:
    #     issue:
    #       created: 'New Agentic issue'
    # users:
    #   alice: 'U0123456789'
  another-project:
    channel_id: 'C0234567890'

users:
  # A null mapping shows the Redmine name when neither login nor email maps to
  # a Slack ID and auto_map_users_by_name is false. This also removes that
  # explicit mapping for other features; auto_map_users_by_email is independent.
  # example-user: null
  # Redmine login name or email address: Slack member ID. Overrides automatic matching.
  alice: 'U0123456789'
  bob: 'U0234567890'
