# Copy this file to the Redmine application's config directory:
#   config/redmine_slack_notification.yml
# Do not commit this file because it contains Slack credentials.

slack:
  # SLACK_BOT_TOKEN can supply the shared token instead.
  bot_token: 'xoxb-REPLACE-ME'
  default_channel_id: 'C0123456789'
  # Requires users:read and an app reinstall. Ambiguous names are not mentioned.
  auto_map_users_by_name: false
  # Authorize Work Object details/thread replies using a unique active Redmine
  # user with a matching registered email. Explicit users mappings take priority.
  # Requires users:read + users:read.email and an app reinstall.
  auto_map_users_by_email: false
  # Match project display names to bot-member channel names (case-insensitive;
  # spaces become hyphens). Explicit project channel IDs take priority.
  # No unique match/API failure falls back to default_channel_id.
  # Requires channels:read (public) / groups:read (private) and app reinstall.
  # Channel listings are cached in process memory for 10 minutes.
  auto_map_channels_by_name: false
  # Add a Task Work Object preview to public Issue creation/update/comment
  # notifications. Enable Work Object Previews > Task in the Slack app too.
  # Existing event cards remain. Deleted Issues and due-date DMs are excluded.
  # Override per project with projects.<identifier>.slack.work_object_previews.
  work_object_previews: false
  # Show editable Issue fields and actions on all public Issue Work Object
  # cards when true. Omitted or false disables actions.
  # Redmine user mapping and permissions are checked again on submission.
  # Set Interactivity & Shortcuts Request URL to /redmine_slack/interactions.
  work_object_actions: false
  # Save text replies to Issue notification threads as Redmine notes.
  # Requires slack.events, explicit users mappings or auto_map_users_by_email,
  # message.groups + groups:history (private channels), and an app reinstall.
  thread_comments: false
  # Post comment-only additions/edits/deletions in the latest Issue notification
  # thread, showing only the comment body (edits/deletions retain body/diffs).
  # Falls back to a full channel notification if no match is found or lookup fails.
  # Requires slack.events.app_id and groups:history / channels:history.
  # Search is bounded to 3 pages of up to 100 channel messages each.
  comment_notifications_in_threads: false
  # Required for clickable Work Object details. Configure the Slack app's
  # Events Request URL as https://redmine.example.com/redmine_slack/events and subscribe
  # to entity_details_requested. Work Object unfurl refresh additionally requires
  # links:read, links:write, link_shared, and the issue host in App unfurl domains.
  # Reinstall the Slack app after changing scopes or unfurl domains.
  # The Signing Secret is NOT the Bot Token.
  # events:
  #   app_id: 'A0123456789'
  #   team_id: 'T0123456789'
  #   signing_secret: 'REPLACE-ME' # or SLACK_SIGNING_SECRET
  # true/false still applies to all edits. Use this map to choose per content type.
  # Deleted comments always show removed lines regardless of these settings.
  body_diff:
    issue:
      description: true
      comment: true
    wiki:
      body: true
    news:
      description: true
      comment: true
  # Six-digit hexadecimal color for the left border of the Slack attachment.
  attachment_color: '#6D5DFB'
  # Issue fields are shown on creation and every update, even when unchanged.
  # Other notification types show their listed metadata fields by default.
  metadata:
    issue:
      project: true
      updater: true
      tracker: true
      category: true
      priority: true
      status: false
      assignee: false
      author: false
      target_version: false
      start_date: false
      due_date: false
      estimated_hours: false
      done_ratio: false
      parent_issue: false
      children: false
      relations: false
      attachments: false
      watchers: false
      custom_fields:
        default: false
        '42': false
    wiki:
      project: true
      updater: true
      location: true
    news:
      project: true
      updater: true
    news_comment:
      project: true
      updater: true
    time_entry:
      project: true
      updater: true
      hours: true
      spent_on: true
    version:
      project: true
      updater: true
      status: true
      due_date: true
    project:
      project: true
      updater: true
  # Also show changes to Issue fields hidden from metadata above.
  # Changes to visible fields and the description diff are always shown.
  issue_changes_when_hidden: true

# Run redmine:slack:due_reminders once daily to DM assigned users until the
# Issue reaches a closed Redmine status. The first DM is 3 days before the due
# date unless the rake task's days option overrides this setting.
due_reminders:
  enabled: true
  days: 3
  colors:
    overdue: '#D92D20'
    today: '#F79009'
    # Uncomment to override the upcoming color. When omitted, it uses
    # slack.attachment_color (default: '#6D5DFB').
    # upcoming: '#6D5DFB'

# All displayed notification wording is optional. The values below are examples;
# edit individual keys as needed. %{...} are placeholders.
messages:
  events:
    issue:
      created: Issue created
      updated: Issue updated
      deleted: Issue deleted
    comment:
      added: Comment added
      updated: Comment updated
      deleted: Comment deleted
    wiki:
      created: Wiki page created
      updated: Wiki page updated
      deleted: Wiki page deleted
    news:
      created: News created
      updated: News updated
      deleted: News deleted
    news_comment:
      added: News comment added
      updated: News comment updated
      deleted: News comment deleted
    time_entry:
      created: Time entry created
      updated: Time entry updated
      deleted: Time entry deleted
    version:
      created: Version created
      updated: Version updated
      deleted: Version deleted
    project:
      updated: Project updated
  icons:
    issue:
      created: '🆕'
      updated: '🔄'
      deleted: '🗑️'
    comment:
      added: '💬'
      updated: '💬'
      deleted: '🗑️'
    wiki:
      created: '📚'
      updated: '✏️'
      deleted: '🗑️'
    news:
      created: '📰'
      updated: '📰'
      deleted: '🗑️'
    news_comment:
      added: '💬'
      updated: '✏️'
      deleted: '🗑️'
    time_entry:
      created: '⏱️'
      updated: '⏱️'
      deleted: '🗑️'
    version:
      created: '🏷️'
      updated: '🏷️'
      deleted: '🗑️'
    project:
      updated: '🗂️'
  sections:
    content: Content
    comment: Comment
    summary: Summary
    changes: Changes
    metadata: Metadata
    added_comment: Added comment
    updated_comment: Updated comment
    description: Description
    body: Body
  fields:
    project: Project
    updater: Updated by
    poster: Posted by
    tracker: Tracker
    category: Category
    priority: Priority
    status: Status
    assignee: Assignee
    target_version: Target version
    parent_issue: Parent issue
    child_issue: Child issue
    subject: Subject
    description: Description
    start_date: Start date
    due_date: Due date
    attachment: Attachment
    relation: Related issue (%{type})
    location: Changed location
    hours: Hours
    spent_on: Spent on
    author: Author
    estimated_hours: Estimated hours
    done_ratio: Done ratio
    children: Child issues
    relations: Related issues
    attachments: Attachments
    watchers: Watchers
    custom_fields: Custom fields
  relations:
    relates: Related
    duplicates: Duplicates
    duplicated: Duplicated by
    blocks: Blocks
    blocked: Blocked by
    precedes: Precedes
    follows: Follows
    copied_to: Copied to
    copied_from: Copied from
  values:
    unknown_user: Unknown user
    unknown: Unknown
    unset: Not set
    none: None
    empty: "(empty)"
    added: Added
    removed: Removed
    created: created
    updated: updated
    deleted: deleted
  diff:
    heading: "%{label} diff"
    omitted: Diff truncated. See the linked page for the full text.
  images:
    preparing: Preparing image
    alt: Image
    link_label: 'Image: %{name}'
  templates:
    # Visible heading for Issue updates, including updates with a comment.
    issue_updated_header: "%{actor} *%{event}*"
    issue_fallback: "[%{project}] %{actor} %{action} %{tracker} #%{id}: %{subject}"
    journal_fallback: "[%{project}] %{actor} %{event} %{tracker} #%{id}: %{subject}"
    generic_fallback: '%{event} - %{subject}'
  # Service name in Work Object cards and the details header/open button.
  # Projects may override any messages key under projects.<identifier>.messages.
  work_objects:
    product_name: 'Redmine'
  # Headings for compact comment notifications inside Slack threads.
  # Supports %{product_name}, %{id}, %{actor}, and %{subject}.
  # References to the current Issue as #%{id} automatically become links.
  thread_notifications:
    added_header: '%{product_name} #%{id}: New comment'
    updated_header: '%{product_name} #%{id}: Comment updated'
    deleted_header: '%{product_name} #%{id}: Comment deleted'
  thread_comments:
    # Supports %{id} and %{product_name}; #%{id} automatically becomes a link.
    saved: '✅ Comment added to Redmine #%{id}.'
    restricted: '⚠️ Could not add the comment. Check the user mapping, Issue permissions and state, and text length.'
  due_reminders:
    # Omit a key to use its built-in default. Projects can override keys under
    # projects.<identifier>.messages.due_reminders.
    part_suffix: ' (%{part}/%{total_parts})'
    fallback: 'Due reminders%{suffix}: %{count} total (overdue: %{overdue_count}, due today: %{today_count})'
    title: '📋 *Due reminders: %{count}%{suffix}*'
    overdue_label: '🚨 Overdue'
    today_label: '⏰ Due today'
    upcoming_label: '📅 Due soon'
    group_fallback: '%{label}: %{count}'
    group_heading: '*%{label} (%{count})*'
    group_continued: '*%{label} (continued)*'
    overdue_timing: '%{days}d overdue'
    upcoming_timing: '%{days}d left'
    timing_suffix: ' · %{timing}'
    issue_line: '• <%{url}|#%{id} %{subject}> · %{project}%{timing}'

# issue.updated.enabled is the parent switch for all Issue detail events below.
# Setting it to false suppresses them even when an individual key is true.
# Newly supported deletion events below default to false; other omitted events default to true.
events:
  issue:
    created: true
    updated:
      enabled: true
      other_changed: true # Tracker and other Issue details
      relation:
        added: true
        removed: true
      status_changed: true
      assignee_changed: true
      priority_changed: true
      category_changed: true
      due_date_changed: true
      start_date_changed: true
      version_changed: true # Issue target version; distinct from events.version.updated
      subject_changed: true
      description_changed: true
      custom_field_changed: true
      attachment:
        added: true
        removed: true
      parent_changed: true
      child:
        added: true
        removed: true
    deleted: true
    comment:
      added: true # Independent of issue.updated.enabled
      updated: true
      deleted: true
  wiki:
    created: true
    updated: true
    deleted: false
  news:
    created: true
    updated: true
    deleted: false
    comment:
      added: true # Independent of news.updated
      updated: true # Detects Comment record updates; standard News UI has no edit action
      deleted: true
  time_entry:
    created: true
    updated: true
    deleted: false
  version:
    created: true
    updated: true
    deleted: false
  project:
    updated: true

projects:
  agentic:
    # The same slack, events, messages, and users trees can be overridden here.
    # Omitted keys inherit global values. A project bot_token overrides SLACK_BOT_TOKEN.
    slack:
      bot_token: 'xoxb-AGENTIC-BOT-TOKEN'
      default_channel_id: 'C0123456789'
      attachment_color: '#123456'
      # work_object_previews: true
    # The older project-level channel_id remains supported.
    # channel_id: 'C0123456789'
    # Every events key can override the matching global value.
    # If the global issue.updated.enabled is false, set it true here to enable details.
    # events:
    #   issue:
    #     updated:
    #       enabled: true
    #       status_changed: false
    #   wiki:
    #     deleted: true
    # messages:
    #   events:
    #     issue:
    #       created: 'New Agentic issue'
    # users:
    #   alice: 'U0123456789'
  another-project:
    channel_id: 'C0234567890'

users:
  # Redmine login name or email address: Slack member ID. Overrides automatic matching.
  alice: 'U0123456789'
  bob: 'U0234567890'
