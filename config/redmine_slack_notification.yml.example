# Copy this file to the Redmine application's config directory:
#   config/redmine_slack_notification.yml
# Do not commit this file because it contains Slack credentials.

slack:
  # Prefer the SLACK_BOT_TOKEN environment variable in production.
  bot_token: 'xoxb-REPLACE-ME'
  default_channel_id: 'C0123456789'
  # Requires users:read and an app reinstall. Ambiguous names are not mentioned.
  auto_map_users_by_name: false

# issue_updated is the parent switch for all Issue detail events below.
# Setting it to false suppresses them even when an individual key is true.
# Newly supported deletion events below default to false; other omitted events default to true.
events:
  issue_created: true
  issue_updated: true
  issue_deleted: true
  comment_added: true
  relation_added: true
  relation_removed: true
  status_changed: true
  assignee_changed: true
  priority_changed: true
  due_date_changed: true
  start_date_changed: true
  version_changed: true # Issue target version; distinct from version_updated below
  subject_changed: true
  description_changed: true
  custom_field_changed: true
  attachment_added: true
  attachment_removed: true
  parent_changed: true
  child_added: true
  child_removed: true
  wiki_created: true
  wiki_updated: true
  wiki_deleted: false
  news_created: true
  news_updated: true
  news_deleted: false
  news_comment_added: true
  time_entry_created: true
  time_entry_updated: true
  time_entry_deleted: false
  version_created: true
  version_updated: true
  version_deleted: false
  project_updated: true

projects:
  agentic:
    channel_id: 'C0123456789'
    # Project events override the global events above.
    # events:
    #   news_updated: false
  another-project:
    channel_id: 'C0234567890'

users:
  # Redmine login name or email address: Slack member ID. Overrides automatic matching.
  alice: 'U0123456789'
  bob: 'U0234567890'
